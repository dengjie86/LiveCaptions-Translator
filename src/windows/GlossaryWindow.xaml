<ui:FluentWindow x:Class="LiveCaptionsTranslator.GlossaryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="术语库" Width="970" Height="660" MinWidth="860" MinHeight="620"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStyle="None"
    WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="术语库" ShowMaximize="True" />
        <StackPanel Grid.Row="1" Margin="20,10,20,16">
            <DockPanel>
                <ui:ToggleSwitch x:Name="GlossaryEnabledSwitch" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    OnContent="已启用" OffContent="已停用" Click="Enabled_Click" />
                <TextBlock Text="让名字和直播用语保持一致" FontSize="21" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock x:Name="ServiceHint" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="365" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ui:TextBox x:Name="GlossarySearchBox" PlaceholderText="搜索原词、译名或语境" TextChanged="Search_Changed" Margin="0,0,0,10" />
                <ListBox x:Name="GlossaryList" Grid.Row="1" SelectionChanged="Entry_Selected"
                    HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="EntryEnabled_Click"
                                    VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="启用此词条" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Translation}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Source}" Margin="0,3,0,0" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TargetLanguage}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <ui:Button x:Name="AddExamplesButton" Content="添加直播示例" Click="Examples_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.7" />
                </DockPanel>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel">
                    <DockPanel Margin="0,0,0,10">
                        <ui:Button x:Name="NewEntryButton" Content="＋ 新增" Click="New_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        <TextBlock x:Name="EditorTitle" Text="新增词条" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="原词／别名" Margin="0,0,0,5" />
                    <ui:TextBox x:Name="TermSourceBox" PlaceholderText="例如：bilibili | ビリビリ | B站" MaxLength="500" TextChanged="Draft_Changed" />
                    <TextBlock Text="多个写法用 | 分隔，也可以填写完整短语。" FontSize="12" Opacity="0.65" Margin="0,4,0,10" />
                    <TextBlock Text="指定译名" Margin="0,0,0,5" />
                    <ui:TextBox x:Name="TermTranslationBox" PlaceholderText="例如：哔哩哔哩" MaxLength="200" TextChanged="Draft_Changed" />
                    <TextBlock Text="适用语境（可选）" Margin="0,12,0,5" />
                    <ui:TextBox x:Name="TermContextBox" PlaceholderText="例如：指直播平台时使用；表示发麻时按原意翻译。"
                        AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" MaxLength="1000" TextChanged="Draft_Changed" />
                    <TextBlock Text="译文语言" Margin="0,12,0,5" />
                    <ui:TextBox x:Name="TermLanguageBox" PlaceholderText="例如：zh-CN" MaxLength="40" TextChanged="Draft_Changed" />
                    <TextBlock Text="与设置中的目标语言一致时生效。" FontSize="12" Opacity="0.65" Margin="0,4,0,10" />
                    <CheckBox x:Name="TermEnabledBox" Content="启用此词条" Click="Draft_Changed" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="SaveTermButton" Content="保存词条" Appearance="Primary" Click="Save_Click" />
                        <ui:Button x:Name="DeleteTermButton" Content="删除" Click="Delete_Click" Margin="10,0,0,0" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="修改后点击保存，从下一次翻译请求起生效。" FontSize="12" Opacity="0.65" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="GlossaryStatusText" Grid.Row="3" Margin="20,14,20,16" TextWrapping="Wrap" Opacity="0.8" />
    </Grid>
</ui:FluentWindow>
