<!-- Modified for the dengjie86 bilingual subtitle edition; see CHANGELOG.md. -->
<Page
    x:Class="LiveCaptionsTranslator.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InfoPage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                <Run Text="双语字幕增强版：本地 Qwen 识别、逐句对齐、滚动历史、术语库与流式翻译。" />
                <Run Text="&#x0A;欢迎通过本仓库的 Issues 反馈问题或提交改进。" />
            </TextBlock>
            <Separator Margin="0,5,0,5" />
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="当前项目：" />
                <Hyperlink NavigateUri="https://github.com/dengjie86/LiveCaptions-Translator" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="dengjie86/LiveCaptions-Translator" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="上游项目：" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run x:Name="Wiki" Text="SakiRinn/LiveCaptions-Translator" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,0,3">
                <Run FontWeight="SemiBold" Text="原版作者：" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="@SakiRinn" />
                </Hyperlink>
                <Run Text=" 与 " />
                <Hyperlink NavigateUri="https://github.com/A-nony-mous" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="@A-nony-mous" />
                </Hyperlink>
            </TextBlock>
            <TextBlock>
                <Run FontWeight="SemiBold" Text="当前版本：" />
                <Hyperlink NavigateUri="https://github.com/dengjie86/LiveCaptions-Translator/releases" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run x:Name="Version" Text="1.1.1.1" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
